# Copy to .env and fill in. Used by docker-compose.yml.

# Public address of this relay: the server's public IP (e.g. 203.0.113.7) or a DNS name pointing here.
# Caddy gets the certificate for it either way.
RELAY_HOST=203.0.113.7

# Optional. When set, a Mac must present this key to register (grenade relay on <url> --key <key>).
# Leave empty for an open relay that anyone's Mac may use.
GRENADE_RELAY_REGISTRATION_KEY=

# Optional. Turns on the dashboard (https://RELAY_HOST/, any user name, this password) and GET /v1/daemons.
# Generate one with: openssl rand -hex 24
GRENADE_RELAY_ADMIN_KEY=

# info or debug
GRENADE_LOG=info
