# Copy to .env and fill in. Used by docker-compose.yml.

# Public address of this relay: the server's public IP (e.g. 203.0.113.7) or a DNS name pointing here.
# Caddy gets the certificate for it either way.
RELAY_HOST=203.0.113.7

# Optional. When set, a Mac must present this key to register (grenade relay on <url> --key <key>).
# Leave empty for an open relay that anyone's Mac may use.
GRENADE_RELAY_REGISTRATION_KEY=

# Optional. Turns on the dashboard (https://RELAY_HOST/, any user name, this password) and GET /v1/daemons.
# Generate one with: openssl rand -hex 24
GRENADE_RELAY_ADMIN_KEY=

# Push notifications. Nothing to set by default: pushes are passed, still sealed, to the main relay, which holds
# the key for the App Store app. Set this to "off" to turn push off, or to another relay's URL.
GRENADE_RELAY_PUSH_UPSTREAM=
# The upstream relay's registration key, when it requires one.
GRENADE_RELAY_PUSH_UPSTREAM_KEY=

# Only for a relay that sends pushes itself, for your own build of the app: an APNs key (.p8) of your Apple
# Developer team. Give the key as text (newlines as \n) or as a file the relay can read.
GRENADE_RELAY_APNS_KEY=
GRENADE_RELAY_APNS_KEY_FILE=
GRENADE_RELAY_APNS_KEY_ID=
GRENADE_RELAY_APNS_TEAM_ID=
# Bundle ids the key sends for, separated by commas.
GRENADE_RELAY_APNS_TOPICS=

# info or debug
GRENADE_LOG=info
